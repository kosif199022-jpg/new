{
  "name": "@new/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'e2e/**'",
    "test:integration": "vitest run --exclude 'e2e/**' --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@new/design-system": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
